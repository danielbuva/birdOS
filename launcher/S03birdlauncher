#!/bin/sh

TARGET="/opt/muos/bin/bird-launcher"
RUN_DIR="/run/muos"
ACTIVE="$RUN_DIR/bird-launcher-active"
READY="$RUN_DIR/bird-system-ready"
STOPPING="$RUN_DIR/bird-launcher-stopping"
SUPERVISOR_PID="$RUN_DIR/bird-launcher-supervisor.pid"
FIRST_FRAME_MARKER="$RUN_DIR/bird-first-frame-ready"
EARLY_LOG="/tmp/bird-launcher-early.log"
PERSISTENT_LOG="/mnt/mmc/MUOS/bespoke-launcher/early-launcher-latest.log"
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
[ -n "$BOOT_ID" ] || BOOT_ID="unknown"
ARCHIVE_LOG="/mnt/mmc/MUOS/bespoke-launcher/early-launcher-$BOOT_ID.log"
LAUNCH_REQUEST="$RUN_DIR/bird-launch-request"
AUDIO_CONTROL="/opt/muos/script/system/pipewire.sh"
MAINLINE_ENV="/run/muos/bird-mainline-env"
# Resolve from /opt/muos/share/core without writing to the preserved root.
MAINLINE_NDS_CORE="../../../../run/bird-rocknix/usr/lib/libretro/melonds_libretro.so"

PREPARE_MAINLINE_CONTENT() {
	[ -r "$MAINLINE_ENV" ] || return 0
	. "$MAINLINE_ENV"
	BIRD_MAINLINE_CONTENT=1
	export BIRD_MAINLINE_CONTENT
	printf 'mainline content runtime start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	BIRD_MAINLINE_PREPARE || {
		printf 'mainline content runtime failed uptime: '
		cut -d ' ' -f 1 /proc/uptime
		return 1
	}
	printf 'mainline content runtime ready uptime: '
	cut -d ' ' -f 1 /proc/uptime
}

SNAPSHOT_LOG() {
	[ -d /mnt/mmc/MUOS ] || return 0
	mkdir -p "${PERSISTENT_LOG%/*}"
	cp -f "$EARLY_LOG" "$PERSISTENT_LOG"
	cp -f "$EARLY_LOG" "$ARCHIVE_LOG"
}

WAIT_RUNTIME() {
	WAIT_COUNT=0
	while [ ! -e "$READY" ] || [ ! -e /usr/lib/gamecontrollerdb.txt ]; do
		[ -e "$STOPPING" ] && return 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		[ "$WAIT_COUNT" -ge 500 ] && {
			printf '%s runtime prerequisites timed out uptime: ' "$1"
			cut -d ' ' -f 1 /proc/uptime
			return 1
		}
		sleep 0.01
	done
	printf '%s runtime ready uptime: ' "$1"
	cut -d ' ' -f 1 /proc/uptime
}

START_AUDIO() {
	if [ -S /run/pipewire-0 ]; then
		return 0
	fi
	printf 'audio demand start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	"$AUDIO_CONTROL" demand-start || {
		printf 'audio demand failed uptime: '
		cut -d ' ' -f 1 /proc/uptime
		"$AUDIO_CONTROL" demand-stop || :
		return 1
	}
	[ -S /run/pipewire-0 ] || {
		"$AUDIO_CONTROL" demand-stop || :
		return 1
	}
	printf 'audio demand ready uptime: '
	cut -d ' ' -f 1 /proc/uptime
}

STOP_AUDIO() {
	[ -e "$RUN_DIR/bird-audio-demand" ] || return 0
	printf 'audio demand stop uptime: '
	cut -d ' ' -f 1 /proc/uptime
	"$AUDIO_CONTROL" demand-stop || :
}

RUN_CONTENT() {
	[ -s "$LAUNCH_REQUEST" ] || {
		printf '%s\n' 'launch bridge error: request missing'
		return 1
	}

	{
		IFS= read -r LAUNCH_KIND
		IFS= read -r CONTENT_CORE
		IFS= read -r CONTENT_NAME
		IFS= read -r CONTENT_PATH
	} <"$LAUNCH_REQUEST"
	rm -f "$LAUNCH_REQUEST"

	[ -f "$CONTENT_PATH" ] || {
		printf 'launch bridge error: content missing: %s\n' "$CONTENT_PATH"
		return 1
	}

	WAIT_RUNTIME content || return 1
	START_AUDIO || return 1
	PREPARE_MAINLINE_CONTENT || return 1

	. /opt/muos/script/var/func.sh
	GOVERNOR_FILE=$(GET_VAR "device" "cpu/governor")
	PREVIOUS_GOVERNOR=$(cat "$GOVERNOR_FILE" 2>/dev/null)
	case "$LAUNCH_KIND:$CONTENT_CORE" in
		2:* | 4:* | 5:* | 6:* | *:flycast* | *:mupen64plus*)
			printf '%s\n' performance >"$GOVERNOR_FILE"
			;;
	esac

	printf 'content launch start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	printf 'content launch kind=%s core=%s name=%s path=%s\n' \
		"$LAUNCH_KIND" "$CONTENT_CORE" "$CONTENT_NAME" "$CONTENT_PATH"
	SNAPSHOT_LOG

	case "$LAUNCH_KIND" in
		1) /opt/muos/script/launch/lr-general.sh "$CONTENT_NAME" "$CONTENT_CORE" "$CONTENT_PATH" ;;
		2) /opt/muos/script/launch/ext-ppsspp.sh "$CONTENT_NAME" "ext-ppsspp" "$CONTENT_PATH" ;;
		3) /opt/muos/script/launch/ext-general.sh "$CONTENT_NAME" "external" "$CONTENT_PATH" ;;
		# The vendor DraStic binary reaches its JIT and traps with SIGILL on the
		# source kernel.  Use ROCKNIX's ABI-stable melonDS libretro core while
		# retaining muOS's existing RetroArch configuration and controls.
		4) /opt/muos/script/launch/lr-general.sh "$CONTENT_NAME" "$MAINLINE_NDS_CORE" "$CONTENT_PATH" ;;
		5) /opt/muos/script/launch/ext-openbor.sh "$CONTENT_NAME" "$CONTENT_CORE" "$CONTENT_PATH" ;;
		6) /opt/muos/script/launch/ext-mpv.sh "$CONTENT_NAME" "$CONTENT_CORE" "$CONTENT_PATH" ;;
		*)
			printf 'launch bridge error: unsupported kind %s\n' "$LAUNCH_KIND"
			STOP_AUDIO
			return 1
			;;
	esac
	CONTENT_RESULT=$?

	[ -n "$PREVIOUS_GOVERNOR" ] && printf '%s\n' "$PREVIOUS_GOVERNOR" >"$GOVERNOR_FILE"
	SET_VAR "system" "foreground_process" "bird-launcher"
	printf 'content launch result: %s\n' "$CONTENT_RESULT"
	printf 'content launch end uptime: '
	cut -d ' ' -f 1 /proc/uptime
	# Audio is session-warm after the menu appears. Retain it across content
	# returns so the next selection never repays daemon startup latency.
	SNAPSHOT_LOG
	return "$CONTENT_RESULT"
}

RUN_PORTMASTER() {
	WAIT_RUNTIME portmaster || return 1
	PREPARE_MAINLINE_CONTENT || return 1
	/opt/muos/script/init/S30dbus demand-start || return 1
	printf 'portmaster network connect start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	/opt/muos/script/system/network.sh connect
	NETWORK_RESULT=$?
	printf 'portmaster network connect result: %s\n' "$NETWORK_RESULT"
	printf 'portmaster network connect end uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG

	if [ "$NETWORK_RESULT" -eq 0 ]; then
		printf 'portmaster start uptime: '
		cut -d ' ' -f 1 /proc/uptime
		/mnt/mmc/MUOS/PortMaster/PortMaster.sh
		PORTMASTER_RESULT=$?
		printf 'portmaster result: %s\n' "$PORTMASTER_RESULT"
		printf 'portmaster end uptime: '
		cut -d ' ' -f 1 /proc/uptime
	else
		PORTMASTER_RESULT=$NETWORK_RESULT
	fi

	/opt/muos/script/system/network.sh disconnect
	/opt/muos/script/init/S30dbus demand-stop || :
	. /opt/muos/script/var/func.sh
	SET_VAR "system" "foreground_process" "bird-launcher"
	printf 'portmaster network disconnected uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	return "$PORTMASTER_RESULT"
}

RUN_SHUTDOWN() {
	WAIT_COUNT=0
	while [ ! -e "$READY" ]; do
		[ -e "$STOPPING" ] && return 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		[ "$WAIT_COUNT" -ge 500 ] && return 1
		sleep 0.01
	done
	printf 'native shutdown request uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	/opt/muos/script/mux/quit.sh poweroff frontend
}

case "$1" in
	start)
		[ -x "$TARGET" ] || exit 0
		mkdir -p "$RUN_DIR"
		if [ -e "$ACTIVE" ] && [ -s "$SUPERVISOR_PID" ]; then
			RUNNING_PID=$(cat "$SUPERVISOR_PID" 2>/dev/null)
			if [ -n "$RUNNING_PID" ] && kill -0 "$RUNNING_PID" 2>/dev/null; then
				exit 0
			fi
		fi
		rm -f "$STOPPING" "$FIRST_FRAME_MARKER"
		: >"$ACTIVE"

		(
			{
				if [ -e "$RUN_DIR/bird-fixed-initramfs-v1" ]; then
					printf '%s\n' 'fixed initramfs path: active'
				fi
				printf 'direct supervisor start uptime: '
					cut -d ' ' -f 1 /proc/uptime
				while :; do
					"$TARGET"
					LAUNCHER_RESULT=$?
					printf 'direct launcher result: %s\n' "$LAUNCHER_RESULT"
					printf 'direct launcher exit uptime: '
					cut -d ' ' -f 1 /proc/uptime
					case "$LAUNCHER_RESULT" in
						10) RUN_CONTENT ;;
						11) RUN_SHUTDOWN || : ;;
						12) RUN_PORTMASTER ;;
						*) break ;;
					esac
				done

				[ -e "$STOPPING" ] && exit 0
				while [ ! -e "$READY" ]; do sleep 0.05; done
				[ -e "$STOPPING" ] && exit 0

				SNAPSHOT_LOG
				rm -f "$ACTIVE"
				START_AUDIO || :
				. /opt/muos/script/var/func.sh
				FRONTEND start
				printf 'stock frontend handoff requested at uptime: '
				cut -d ' ' -f 1 /proc/uptime
			} >"$EARLY_LOG" 2>&1
		) &
		printf '%s\n' "$!" >"$SUPERVISOR_PID"
		;;
	stop)
		mkdir -p "$RUN_DIR"
		: >"$STOPPING"
		if [ -s "$SUPERVISOR_PID" ]; then
			kill "$(cat "$SUPERVISOR_PID")" 2>/dev/null || :
		fi
		killall -TERM bird-launcher 2>/dev/null || :
		rm -f "$ACTIVE" "$SUPERVISOR_PID" "$FIRST_FRAME_MARKER"
		;;
	*)
		printf 'Usage: %s {start|stop}\n' "$0" >&2
		exit 1
		;;
esac

exit 0
