#!/bin/sh

TARGET="/opt/muos/bin/dani-launcher"
RUN_DIR="/run/muos"
ACTIVE="$RUN_DIR/dani-launcher-active"
READY="$RUN_DIR/dani-system-ready"
STOPPING="$RUN_DIR/dani-launcher-stopping"
SUPERVISOR_PID="$RUN_DIR/dani-launcher-supervisor.pid"
EARLY_LOG="/tmp/dani-launcher-early.log"
PERSISTENT_LOG="/mnt/mmc/MUOS/bespoke-launcher/early-launcher-latest.log"
LAUNCH_REQUEST="$RUN_DIR/dani-launch-request"

SNAPSHOT_LOG() {
	[ -d /mnt/mmc/MUOS ] || return 0
	mkdir -p "${PERSISTENT_LOG%/*}"
	cp -f "$EARLY_LOG" "$PERSISTENT_LOG"
}

WAIT_RUNTIME() {
	WAIT_COUNT=0
	while [ ! -e "$READY" ] || [ ! -S /run/pipewire-0 ] || \
		[ ! -e /usr/lib/gamecontrollerdb.txt ]; do
		[ -e "$STOPPING" ] && return 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		[ "$WAIT_COUNT" -ge 500 ] && {
			printf '%s runtime prerequisites timed out uptime: ' "$1"
			cut -d ' ' -f 1 /proc/uptime
			return 1
		}
		sleep 0.01
	done
	printf '%s runtime ready uptime: ' "$1"
	cut -d ' ' -f 1 /proc/uptime
}

RUN_GAME() {
	[ -s "$LAUNCH_REQUEST" ] || {
		printf '%s\n' 'launch bridge error: request missing'
		return 1
	}

	{
		IFS= read -r LAUNCH_KIND
		IFS= read -r GAME_NAME
		IFS= read -r GAME_PATH
	} <"$LAUNCH_REQUEST"
	rm -f "$LAUNCH_REQUEST"

	[ -f "$GAME_PATH" ] || {
		printf 'launch bridge error: ROM missing: %s\n' "$GAME_PATH"
		return 1
	}

	WAIT_RUNTIME game || return 1

	. /opt/muos/script/var/func.sh
	GOVERNOR_FILE=$(GET_VAR "device" "cpu/governor")
	PREVIOUS_GOVERNOR=$(cat "$GOVERNOR_FILE" 2>/dev/null)
	[ "$LAUNCH_KIND" = "2" ] && printf '%s\n' performance >"$GOVERNOR_FILE"

	printf 'game launch start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	printf 'game launch kind=%s name=%s path=%s\n' "$LAUNCH_KIND" "$GAME_NAME" "$GAME_PATH"
	SNAPSHOT_LOG

	case "$LAUNCH_KIND" in
		1) /opt/muos/script/launch/lr-general.sh "$GAME_NAME" "snes9x_libretro.so" "$GAME_PATH" ;;
		2) /opt/muos/script/launch/ext-ppsspp.sh "$GAME_NAME" "ext-ppsspp" "$GAME_PATH" ;;
		3) /opt/muos/script/launch/ext-general.sh "$GAME_NAME" "external" "$GAME_PATH" ;;
		*)
			printf 'launch bridge error: unsupported kind %s\n' "$LAUNCH_KIND"
			return 1
			;;
	esac
	GAME_RESULT=$?

	[ -n "$PREVIOUS_GOVERNOR" ] && printf '%s\n' "$PREVIOUS_GOVERNOR" >"$GOVERNOR_FILE"
	SET_VAR "system" "foreground_process" "dani-launcher"
	printf 'game launch result: %s\n' "$GAME_RESULT"
	printf 'game launch end uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	return "$GAME_RESULT"
}

RUN_PORTMASTER() {
	WAIT_RUNTIME portmaster || return 1
	printf 'portmaster network connect start uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	/opt/muos/script/system/network.sh connect
	NETWORK_RESULT=$?
	printf 'portmaster network connect result: %s\n' "$NETWORK_RESULT"
	printf 'portmaster network connect end uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG

	if [ "$NETWORK_RESULT" -eq 0 ]; then
		printf 'portmaster start uptime: '
		cut -d ' ' -f 1 /proc/uptime
		/mnt/mmc/MUOS/PortMaster/PortMaster.sh
		PORTMASTER_RESULT=$?
		printf 'portmaster result: %s\n' "$PORTMASTER_RESULT"
		printf 'portmaster end uptime: '
		cut -d ' ' -f 1 /proc/uptime
	else
		PORTMASTER_RESULT=$NETWORK_RESULT
	fi

	/opt/muos/script/system/network.sh disconnect
	. /opt/muos/script/var/func.sh
	SET_VAR "system" "foreground_process" "dani-launcher"
	printf 'portmaster network disconnected uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	return "$PORTMASTER_RESULT"
}

RUN_SHUTDOWN() {
	WAIT_COUNT=0
	while [ ! -e "$READY" ]; do
		[ -e "$STOPPING" ] && return 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		[ "$WAIT_COUNT" -ge 500 ] && return 1
		sleep 0.01
	done
	printf 'native shutdown request uptime: '
	cut -d ' ' -f 1 /proc/uptime
	SNAPSHOT_LOG
	/opt/muos/script/mux/quit.sh poweroff frontend
}

case "$1" in
	start)
		[ -x "$TARGET" ] || exit 0
		mkdir -p "$RUN_DIR"
		rm -f "$STOPPING"
		: >"$ACTIVE"

		(
			{
				printf 'direct supervisor start uptime: '
				cut -d ' ' -f 1 /proc/uptime
				while :; do
					"$TARGET"
					LAUNCHER_RESULT=$?
					printf 'direct launcher result: %s\n' "$LAUNCHER_RESULT"
					printf 'direct launcher exit uptime: '
					cut -d ' ' -f 1 /proc/uptime

					case "$LAUNCHER_RESULT" in
						10) RUN_GAME ;;
						11) RUN_SHUTDOWN || : ;;
						12) RUN_PORTMASTER ;;
						*) break ;;
					esac
				done

				[ -e "$STOPPING" ] && exit 0
				while [ ! -e "$READY" ]; do sleep 0.05; done
				[ -e "$STOPPING" ] && exit 0

				mkdir -p "${PERSISTENT_LOG%/*}"
				cp -f "$EARLY_LOG" "$PERSISTENT_LOG"
				rm -f "$ACTIVE"
				. /opt/muos/script/var/func.sh
				FRONTEND start
				printf 'stock frontend handoff requested at uptime: '
				cut -d ' ' -f 1 /proc/uptime
			} >"$EARLY_LOG" 2>&1
		) &
		printf '%s\n' "$!" >"$SUPERVISOR_PID"
		;;
	stop)
		mkdir -p "$RUN_DIR"
		: >"$STOPPING"
		if [ -s "$SUPERVISOR_PID" ]; then
			kill "$(cat "$SUPERVISOR_PID")" 2>/dev/null || :
		fi
		killall -TERM dani-launcher 2>/dev/null || :
		rm -f "$ACTIVE" "$SUPERVISOR_PID"
		;;
	*)
		printf 'Usage: %s {start|stop}\n' "$0" >&2
		exit 1
		;;
esac

exit 0
