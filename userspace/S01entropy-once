#!/bin/sh

# Seed early exactly as before, then remove haveged when this kernel explicitly
# reports that its CRNG is initialized. The old 256-bit counter test can remain
# below 256 even after the CRNG is ready, which left haveged resident.
ENTROPY_FILE="/proc/sys/kernel/random/entropy_avail"
ENTROPY_TARGET=256
STAGES="/tmp/muos/entropy-once.tsv"
RESULTS="/mnt/mmc/MUOS/boot-timing/entropy-once/results"

mkdir -p /tmp/muos

mark() {
	IFS=' ' read -r NOW _ </proc/uptime
	printf '%s\t%s\n' "$NOW" "$1" >>"$STAGES"
}

entropy_ok() {
	IFS= read -r CURRENT_ENTROPY <"$ENTROPY_FILE" 2>/dev/null || return 1
	[ -n "$CURRENT_ENTROPY" ] && [ "$CURRENT_ENTROPY" -ge "$ENTROPY_TARGET" ]
}

crng_ok() {
	dmesg 2>/dev/null | grep -q 'random: crng init done'
}

persist() {
	[ -d /mnt/mmc/MUOS ] || return 0
	BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
	[ -n "$BOOT_ID" ] || BOOT_ID=unknown
	mkdir -p "$RESULTS"
	cp -f "$STAGES" "$RESULTS/$BOOT_ID.tsv"
	cp -f "$STAGES" "$RESULTS/latest.tsv"
	{
		printf 'haveged_pids='
		pidof haveged 2>/dev/null || :
	} >"$RESULTS/latest-processes.txt"
}

start_once() {
	printf 'uptime_s\tevent\n' >"$STAGES"
	/opt/muos/bin/haveged -w 1024 -T 4 &
	mark haveged-started

	(
		COUNT=0
		while ! crng_ok && [ "$COUNT" -lt 80 ]; do
			COUNT=$((COUNT + 1))
			sleep 0.10
		done

		if ! crng_ok; then
			mark crng-timeout-haveged-retained
			persist
			exit 0
		fi
		mark crng-ready

		killall haveged 2>/dev/null || :
		STOP_COUNT=0
		while [ -n "$(pidof haveged 2>/dev/null)" ] && [ "$STOP_COUNT" -lt 20 ]; do
			STOP_COUNT=$((STOP_COUNT + 1))
			sleep 0.05
		done
		if [ -n "$(pidof haveged 2>/dev/null)" ]; then
			killall -9 haveged 2>/dev/null || :
			mark haveged-force-stopped
		else
			mark haveged-stopped
		fi
		persist
	) &
}

stop_once() {
	killall haveged 2>/dev/null || :
	mark haveged-stop-requested
}

case "${1-}" in
	start) start_once ;;
	stop) stop_once ;;
	restart)
		stop_once
		start_once
		;;
	status)
		crng_ok
		;;
	*)
		printf 'Usage: %s {start|stop|restart|status}\n' "$0" >&2
		exit 1
		;;
esac
