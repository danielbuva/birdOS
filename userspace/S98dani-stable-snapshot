#!/bin/sh

ROOT="/mnt/mmc/MUOS/boot-timing/stable-runtime"
ARM="$ROOT/armed"

[ "${1-}" = start ] || exit 0

# Async init begins before the ROM partition is mounted.  The original hook
# tested its card-side arm file immediately and silently exited every time.
# Wait for the fixed mount service before deciding whether this boot is armed.
WAIT=0
while [ ! -d /mnt/mmc/MUOS ]; do
	WAIT=$((WAIT + 1))
	[ "$WAIT" -lt 2000 ] || exit 0
	sleep 0.01
done
[ -f "$ARM" ] || exit 0

# Capture the stable post-menu process set after delayed low-power work starts.
sleep 20

BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
[ -n "$BOOT_ID" ] || BOOT_ID=unknown
DEST="$ROOT/results/$BOOT_ID"
mkdir -p "$DEST"

cat /proc/uptime >"$DEST/uptime.txt"
cat /proc/meminfo >"$DEST/meminfo.txt"
cat /proc/modules >"$DEST/modules.txt"
cat /proc/mounts >"$DEST/mounts.txt"
cat /proc/interrupts >"$DEST/interrupts.txt" 2>/dev/null || :
[ ! -r /proc/wakelocks ] || cat /proc/wakelocks >"$DEST/wakelocks.txt"
ps >"$DEST/processes.txt"

{
	for PROC in /proc/[0-9]*; do
		[ -r "$PROC/status" ] || continue
		PID=${PROC##*/}
		NAME=$(sed -n 's/^Name:[[:space:]]*//p' "$PROC/status" | head -n 1)
		PPID=$(sed -n 's/^PPid:[[:space:]]*//p' "$PROC/status" | head -n 1)
		STATE=$(sed -n 's/^State:[[:space:]]*//p' "$PROC/status" | head -n 1)
		CMD=$(tr '\000' ' ' <"$PROC/cmdline" 2>/dev/null)
		printf '%s\t%s\t%s\t%s\t%s\n' "$PID" "$PPID" "$STATE" "$NAME" "$CMD"
	done
} >"$DEST/process-detail.tsv"

{
	printf 'dbus='; pidof dbus-daemon 2>/dev/null || :
	printf '\npipewire='; pidof pipewire 2>/dev/null || :
	printf '\nwireplumber='; pidof wireplumber 2>/dev/null || :
	printf '\nhaveged='; pidof haveged 2>/dev/null || :
	printf '\nudevd='; pidof udevd 2>/dev/null || :
	printf '\nunionfs='; pidof unionfs 2>/dev/null || :
	printf '\n'
} >"$DEST/key-processes.txt"

sha256sum \
	/opt/muos/script/system/startup.sh \
	/opt/muos/script/system/pipewire.sh \
	/opt/muos/script/init/sysinit \
	/usr/share/wireplumber/main.lua.d/89-dani-fixed-device.lua \
	/usr/share/wireplumber/bluetooth.lua.d/89-dani-fixed-device.lua \
	>"$DEST/active-sha256sums.txt" 2>/dev/null || :

[ ! -f /tmp/muos/audio-on-demand.tsv ] || cp -f /tmp/muos/audio-on-demand.tsv "$DEST/audio.tsv"
[ ! -f /tmp/muos/fixed-bind.tsv ] || cp -f /tmp/muos/fixed-bind.tsv "$DEST/storage-bind.tsv"
[ ! -f /tmp/muos/entropy-once.tsv ] || cp -f /tmp/muos/entropy-once.tsv "$DEST/entropy.tsv"

printf '%s\n' "$BOOT_ID" >"$ROOT/latest"
rm -f "$ARM"

# This is an explicitly armed diagnostic, not a permanent boot service.  A
# successful capture removes the rootfs hook as well as its arm file.
rm -f /opt/muos/script/init/async/S98dani-stable-snapshot
