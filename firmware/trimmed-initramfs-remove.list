# Exact payloads excluded from Dani's fixed RG34XX-SP initramfs.
# D removes a directory tree; F removes one file or symlink.
D usr/share/alsa
D usr/share/misc
D var/lib/alsa
F etc/mke2fs.conf
F usr/bin/chattr
F usr/bin/file
F usr/bin/genext2fs
F usr/bin/lsattr
F usr/bin/rz
F usr/bin/sz
F usr/sbin/badblocks
F usr/sbin/dumpe2fs
F usr/sbin/e2freefrag
F usr/sbin/e2label
F usr/sbin/e2undo
F usr/sbin/filefrag
F usr/sbin/findfs
F usr/sbin/fsck
F usr/sbin/logsave
F usr/sbin/mke2fs
F usr/sbin/mkfs.ext2
F usr/sbin/mkfs.ext3
F usr/sbin/mkfs.ext4
F usr/sbin/mkfs.ext4dev
F usr/sbin/mklost+found
F usr/sbin/tune2fs
F sbin/fsck.fat
F sbin/mkfs.fat
F sbin/mount.cifs
F usr/lib/libasound.so
F usr/lib/libasound.so.2
F usr/lib/libasound.so.2.0.0
F usr/lib/libmagic.so
F usr/lib/libmagic.so.1
F usr/lib/libmagic.so.1.0.0
F usr/lib/libss.so
F usr/lib/libss.so.2
F usr/lib/libss.so.2.0
F usr/lib/libz.so
F usr/lib/libz.so.1
F usr/lib/libz.so.1.2.8
F lib/libdl.so.2
F lib/libm.so.6
F lib/librt.so.1
