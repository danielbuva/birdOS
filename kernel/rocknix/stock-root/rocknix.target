[Unit]
Description=ROCKNIX compatibility baseline with guarded Bird handoff
Requires=multi-user.target graphical.target
Wants=essway.service input.service powerstate.service rocknix-report-stats.service
After=graphical.target
Conflicts=rescue.target
AllowIsolate=yes
JobTimeoutSec=45s
JobTimeoutAction=reboot-force

[Install]
Alias=default.target
