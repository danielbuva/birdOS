#!/bin/sh
# Preserve the exact final ROCKNIX common-autostart action and publish the
# earliest point at which its generated application/Sway contract is usable.

ln -sf /etc/profile.d/999-export /storage/.config/profile.d
mkdir -p /run/bird
cut -d ' ' -f 1 /proc/uptime > /run/bird/application-contract-ready
