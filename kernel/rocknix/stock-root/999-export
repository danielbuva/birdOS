#!/bin/sh
# The RG34XX-SP has one fixed internal panel. Avoid modetest-based display
# discovery, then publish the application/Sway compatibility milestone.  The
# marker is a contract, not a progress hint: never leave an old or partial
# marker behind when any required profile operation fails.

set -eu

PROFILE_DIR=/storage/.config/profile.d
SWAY_DIR=/storage/.config/sway
PLATFORM_STAGE=/run/bird/fixed-platform
SWAY_STAGE=/run/bird/fixed-sway
PANEL_PROFILE=$PROFILE_DIR/080-dual_screen_mode
UI_PROFILE=$PROFILE_DIR/090-ui_service
SWAY_PROFILE=$PROFILE_DIR/095-sway
SWAY_CONFIG=$SWAY_DIR/config
SYSTEM_EXPORT=/etc/profile.d/999-export
CONTROLLER_PROFILE_SOURCE=/flash/bird/bird-controller-profile
EXPORT_LINK=$PROFILE_DIR/999-export
READY_DIR=/run/bird
READY=$READY_DIR/application-contract-ready
CONTRACT_REVISION=bird-application-v1
PROFILE_TMP=$PROFILE_DIR/.080-dual_screen_mode.tmp.$$
LINK_TMP=$PROFILE_DIR/.999-export.tmp.$$
READY_TMP=$READY_DIR/.application-contract-ready.tmp.$$

cleanup() {
	rm -f "$PROFILE_TMP" "$LINK_TMP" "$READY_TMP" 2>/dev/null || :
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

[ ! -e "$READY" ] && [ ! -L "$READY" ] || rm -f "$READY"
[ -d "$PROFILE_DIR" ] || mkdir -p "$PROFILE_DIR"
[ -d "$READY_DIR" ] || mkdir -p "$READY_DIR"
[ -r "$SYSTEM_EXPORT" ]
[ ! -d "$PANEL_PROFILE" ]
[ ! -d "$EXPORT_LINK" ]

file_matches_lines() {
	CURRENT=$1
	shift
	[ -f "$CURRENT" ] || return 1
	MATCH=1
	exec 3<"$CURRENT"
	for EXPECTED in "$@"; do
		ACTUAL=
		if ! IFS= read -r ACTUAL <&3 || [ "$ACTUAL" != "$EXPECTED" ]; then
			MATCH=0
			break
		fi
	done
	if [ "$MATCH" -eq 1 ]; then
		ACTUAL=
		if IFS= read -r ACTUAL <&3 || [ -n "$ACTUAL" ]; then
			MATCH=0
		fi
	fi
	exec 3<&-
	[ "$MATCH" -eq 1 ]
}

# The producer stage and persistent copy are small newline-terminated text
# contracts. Compare them in this shell so application readiness does not fork
# one cmp process for every fixed profile. A final partial line is invalid even
# when both files contain the same truncated bytes.
text_files_match() {
	LEFT_PATH=$1
	RIGHT_PATH=$2
	[ -f "$LEFT_PATH" ] && [ -f "$RIGHT_PATH" ] || return 1
	MATCH=1
	exec 3<"$LEFT_PATH"
	exec 4<"$RIGHT_PATH"
	while :; do
		LEFT=
		RIGHT=
		LEFT_READ=0
		RIGHT_READ=0
		IFS= read -r LEFT <&3 && LEFT_READ=1
		IFS= read -r RIGHT <&4 && RIGHT_READ=1
		if [ "$LEFT_READ" -ne "$RIGHT_READ" ] || [ "$LEFT" != "$RIGHT" ]; then
			MATCH=0
			break
		fi
		if [ "$LEFT_READ" -eq 0 ]; then
			[ -z "$LEFT" ] && [ -z "$RIGHT" ] || MATCH=0
			break
		fi
	done
	exec 3<&-
	exec 4<&-
	[ "$MATCH" -eq 1 ]
}

PANEL_FIRST=
PANEL_SECOND=
PANEL_READY=0
if [ -f "$PANEL_PROFILE" ]; then
	exec 3<"$PANEL_PROFILE"
	if IFS= read -r PANEL_FIRST <&3 && \
		! IFS= read -r PANEL_SECOND <&3 && \
		[ "$PANEL_FIRST" = 'DEVICE_HAS_DUAL_SCREEN=false' ]; then
		PANEL_READY=1
	fi
	exec 3<&-
fi
if [ "$PANEL_READY" -ne 1 ]; then
	printf '%s\n' 'DEVICE_HAS_DUAL_SCREEN=false' >"$PROFILE_TMP"
	chmod 0644 "$PROFILE_TMP"
	mv -f "$PROFILE_TMP" "$PANEL_PROFILE"
fi
file_matches_lines "$PANEL_PROFILE" 'DEVICE_HAS_DUAL_SCREEN=false'

EXPORT_TARGET=
if [ -L "$EXPORT_LINK" ]; then
	EXPORT_TARGET=$(readlink "$EXPORT_LINK") || EXPORT_TARGET=
fi
if [ "$EXPORT_TARGET" = "$SYSTEM_EXPORT" ]; then
	:
else
	ln -s "$SYSTEM_EXPORT" "$LINK_TMP"
	mv -f "$LINK_TMP" "$EXPORT_LINK"
fi
[ -L "$EXPORT_LINK" ]
[ -r "$EXPORT_LINK" ]

# ROCKNIX's generic autostart coordinator deliberately continues after an
# individual quirk fails.  This final marker must therefore validate the
# outputs of every earlier fixed-profile producer that the application path
# consumes, rather than assuming their position in the loop means success.
for PROFILE_NAME in 001-device_config 002-turbo-mode_config 010-governors \
	010-led_control 020-fan_control 050-modifiers 091-ui_shader; do
	[ -r "$PLATFORM_STAGE/$PROFILE_NAME" ]
	[ -r "$PROFILE_DIR/$PROFILE_NAME" ]
	text_files_match "$PLATFORM_STAGE/$PROFILE_NAME" "$PROFILE_DIR/$PROFILE_NAME"
done
[ -r "$PROFILE_DIR/098-controller" ]
text_files_match "$CONTROLLER_PROFILE_SOURCE" "$PROFILE_DIR/098-controller"
[ -r "$SWAY_STAGE/config" ]
[ -r "$SWAY_CONFIG" ]
text_files_match "$SWAY_STAGE/config" "$SWAY_CONFIG"
[ -r "$SWAY_STAGE/095-sway" ]
[ -r "$SWAY_PROFILE" ]
text_files_match "$SWAY_STAGE/095-sway" "$SWAY_PROFILE"
file_matches_lines "$UI_PROFILE" 'UI_SERVICE="essway.service"'

UPTIME=
UNUSED=
IFS=' ' read -r UPTIME UNUSED </proc/uptime || exit 1
case "$UPTIME" in
	''|*[!0-9.]*) exit 1 ;;
esac
{
	printf 'contract_revision=%s\n' "$CONTRACT_REVISION"
	printf 'published_uptime=%s\n' "$UPTIME"
} >"$READY_TMP"
chmod 0644 "$READY_TMP"
file_matches_lines "$READY_TMP" \
	"contract_revision=$CONTRACT_REVISION" \
	"published_uptime=$UPTIME"
mv -f "$READY_TMP" "$READY"

trap - 0
