[Unit]
Description=Bird requested post-frame diagnostics
After=rocknix-autostart.service
ConditionPathExists=|/storage/bird-data/Bird/boot-diagnostics.request
ConditionPathExists=|/storage/bird-data/Bird/stage5-idle-window.request

[Service]
Type=simple
Nice=19
IOSchedulingClass=idle
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
RuntimeMaxSec=120s
ExecStart=/flash/bird/capture-requested-diagnostics.sh
