[Unit]
Description=Bird requested post-frame boot snapshot
After=rocknix-autostart.service
ConditionPathExists=/storage/.config/bird/boot-diagnostics.request

[Service]
Type=simple
Nice=19
IOSchedulingClass=idle
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
RuntimeMaxSec=20s
ExecStart=/flash/bird/capture-boot-state.sh
