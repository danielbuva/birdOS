[Unit]
Description=Bird launcher handoff at the stable ROCKNIX graphical boundary
DefaultDependencies=no
Requires=rocknix-automount.service
After=rocknix-automount.service graphical.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
ExecStartPre=/flash/bird/first-frame-prep.sh
ExecStart=/flash/bird/supervisor.sh
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rocknix.target
