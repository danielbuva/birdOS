FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
	bc \
	bison \
	build-essential \
	ca-certificates \
	cpio \
	dwarves \
	flex \
	git \
	kmod \
	libelf-dev \
	libssl-dev \
	make \
	patch \
	python3 \
	rsync \
	xz-utils \
	&& rm -rf /var/lib/apt/lists/*

ARG KERNEL_COMMIT=bb532bfaf7919c7c98caab81864e9ce2646e11e3
RUN git init /src/linux \
	&& cd /src/linux \
	&& git remote add origin https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git \
	&& git fetch --depth 1 origin "$KERNEL_COMMIT" \
	&& git checkout --detach FETCH_HEAD \
	&& test "$(git rev-parse HEAD)" = "$KERNEL_COMMIT"

ARG ROCKNIX_COMMIT=d88cf6393e55364ec6470d625737125fc0d32cd4
RUN git init /src/rocknix \
	&& cd /src/rocknix \
	&& git remote add origin https://github.com/ROCKNIX/distribution.git \
	&& git fetch --depth 1 origin "$ROCKNIX_COMMIT" \
	&& git checkout --detach FETCH_HEAD \
	&& test "$(git rev-parse HEAD)" = "$ROCKNIX_COMMIT"

# Start with ROCKNIX's hardware-used H700 enablement, but deliberately omit:
# - its out-of-tree joypad conversion (we use upstream adc-joystick bindings);
# - RGB support (not part of the requested device experience);
# - distro identity metadata and HDMI-audio glue.
RUN cd /src/linux \
	&& set -eu \
	&& for patch in \
		0002-rg35xx-enable-HDMI-LCD.patch \
		0003-Update-sun8i_tcon_top.c.patch \
		0007-rg35xx-add-GPU-opp.patch \
		0008-sun20i-add-pwm-driver.patch \
		0009-h616-add-pwm-node.patch \
		0010-rg35xx-enable-pwm-backlight.patch \
		0040-Revert-usb-musb-Fix-hardware-lockup-on-first-Rx-endp.patch \
		0110-v2_20250226_kikuchan98_drm_panel_add_generic_mipi_panel_driver.patch \
		0111-rg35xx-2024-use-panel-mipi-dpi-spi-driver.patch \
		0124-battery-name.patch \
		0126-20241018_macroalpha82_rg35xx_add_additional_hardware_support.patch \
		0127-enable-mmc1-for-RG35XX-2024.patch \
		0151-phy-fix-OTG-host-mode.patch \
		0152-rg35xx-2024-enable-usb-otg.patch \
		0155-sun4i-set-rgb-connector-as-DSI.patch \
		0200-h700-update-opps.patch \
		0901-dts-rg35xx-2024-fix-led-1-color.patch; do \
		patch --batch --forward --fuzz=3 -p1 \
			< "/src/rocknix/projects/ROCKNIX/devices/H700/patches/linux/$patch"; \
	done

# The internal display must be usable before the real root filesystem is
# available. Embed only this fixed panel's tiny command stream; wireless
# firmware remains outside the kernel so Wi-Fi/Bluetooth can stay on demand.
RUN mkdir -p /src/panel-firmware/panels \
	&& cp \
		'/src/rocknix/projects/ROCKNIX/packages/linux-firmware/kernel-firmware/extra-firmware/panels/anbernic,rg34xx-sp-panel.panel' \
		'/src/panel-firmware/panels/'

COPY kernel/mainline/sun50i-h700-anbernic-rg34xx-sp-dani.dts \
	/src/linux/arch/arm64/boot/dts/allwinner/
COPY kernel/mainline/sun50i-h700-anbernic-rg34xx-sp-dani-diagnostic.dts \
	/src/linux/arch/arm64/boot/dts/allwinner/

RUN printf '%s\n' \
	'dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h700-anbernic-rg34xx-sp-dani.dtb' \
	'dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h700-anbernic-rg34xx-sp-dani-diagnostic.dtb' \
	>> /src/linux/arch/arm64/boot/dts/allwinner/Makefile \
	&& cp /src/rocknix/projects/ROCKNIX/devices/H700/linux/linux.aarch64.conf \
		/src/linux/.config \
	&& /src/linux/scripts/config --file /src/linux/.config \
		--set-str CONFIG_DEFAULT_HOSTNAME "dani-sp" \
		--set-str CONFIG_INITRAMFS_SOURCE "" \
		--set-str CONFIG_LOCALVERSION "-dani-compat" \
		--set-str CONFIG_EXTRA_FIRMWARE \
			"panels/anbernic,rg34xx-sp-panel.panel" \
		--set-str CONFIG_EXTRA_FIRMWARE_DIR "/src/panel-firmware" \
		--enable CONFIG_RTC_DRV_PCF8563 \
		--disable CONFIG_LOCALVERSION_AUTO \
	&& make -C /src/linux ARCH=arm64 olddefconfig \
	&& ! grep -q '@[^@]*@' /src/linux/.config \
	&& grep -qx 'CONFIG_RTC_DRV_PCF8563=y' /src/linux/.config

ENV ARCH=arm64
WORKDIR /src/linux
